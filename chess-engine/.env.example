# Supabase secret key (sb_secret_...) for writing analysis results back to the DB.
# The legacy SUPABASE_SERVICE_KEY is still read as a fallback.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Shared secret callers must send in the X-Engine-Key header (the game server and the
# Next.js /api/maverick-move route). REQUIRED: while it is unset every endpoint except
# GET /health answers 503. Generate: openssl rand -hex 32
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Path to stockfish binary (defaults to "stockfish" on PATH)
STOCKFISH_PATH=/usr/bin/stockfish

# Stockfish instance pool size (default 4)
STOCKFISH_POOL_SIZE=4
