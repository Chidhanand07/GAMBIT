# Chess engine (chess-engine/.env). Reference: DEPLOY.md section 3c.
# The engine does NOT load this file. Export it before starting:
#   set -a && source .env && set +a && venv/bin/uvicorn main:app --port 8001 --reload
# or pass it to Docker: docker run --env-file chess-engine/.env ...

# Shared secret callers must send in X-Engine-Key (the game server and the web app's
# /api/maverick-move). REQUIRED: while it is unset every endpoint except GET /health answers 503.
# Generate: openssl rand -hex 32
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Supabase project URL and secret key (sb_secret_...), used to check games and store post-game
# reviews. Without them /analyse-game answers 503. Legacy key name still read: SUPABASE_SERVICE_KEY.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Path to the Stockfish binary. Unset -> "stockfish" on PATH (fine after `brew install stockfish`).
# The Docker image sets /usr/games/stockfish itself: do NOT set it on Render.
# On Debian/Ubuntu without Docker:
# STOCKFISH_PATH=/usr/games/stockfish

# Optional: Stockfish instance pool size. Default 4 (render.yaml sets 2).
# STOCKFISH_POOL_SIZE=4

# Optional: bounded wait for an instance. At most STOCKFISH_POOL_SIZE requests use the engine and
# at most ENGINE_MAX_QUEUE more wait, each for at most ENGINE_QUEUE_TIMEOUT_SECONDS (must be > 0);
# beyond that: 503 {"detail": "Engine busy"} with Retry-After. GET /health never waits.
# Defaults: 2 x STOCKFISH_POOL_SIZE and 5 seconds.
# ENGINE_MAX_QUEUE=8
# ENGINE_QUEUE_TIMEOUT_SECONDS=5

# Optional: MAVERICK style model weights. Default style_model.pt next to main.py (tracked in git).
# STYLE_MODEL_PATH=style_model.pt

# Optional fallback when the weights file is missing: an https URL to download it from at startup
# (no token in it) and the SHA-256 it must have (REQUIRED with the URL: `shasum -a 256 style_model.pt`).
# A download that does not match is deleted and the style model stays unavailable. When the checksum
# is set, a file already on disk must match it too. Leave both unset to use the tracked file.
# MAVERICK_MODEL_URL=https://example.com/style_model.pt
# MAVERICK_MODEL_SHA256=64_hex_characters

# PORT is used only by the Docker image (default 8001; Render sets it). Locally pass --port to uvicorn.
