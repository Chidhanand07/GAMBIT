# Supabase secret key (sb_secret_...) for writing analysis results back to the DB.
# The legacy SUPABASE_SERVICE_KEY is still read as a fallback.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Shared secret callers must send in the X-Engine-Key header (the game server and the
# Next.js /api/maverick-move route). REQUIRED: while it is unset every endpoint except
# GET /health answers 503. Generate: openssl rand -hex 32
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Path to the Stockfish binary. Unset -> "stockfish" on PATH (fine after
# `brew install stockfish`). The Docker image sets it itself (/usr/games/stockfish),
# so do NOT set it on Render. On Debian/Ubuntu without Docker: /usr/games/stockfish
# STOCKFISH_PATH=/usr/games/stockfish

# Stockfish instance pool size (default 4)
STOCKFISH_POOL_SIZE=4

# MAVERICK style model weights (default: style_model.pt next to main.py, tracked in git).
# STYLE_MODEL_PATH=style_model.pt

# Optional fallback when the weights file is not at STYLE_MODEL_PATH: an https URL to
# download it from at startup, and the SHA-256 it must have (REQUIRED with the URL;
# compute it with `shasum -a 256 style_model.pt`). A download that does not match is
# deleted and the style model stays unavailable. When the checksum is set, a file
# already on disk must match it too. Leave both empty to use the tracked file.
MAVERICK_MODEL_URL=
MAVERICK_MODEL_SHA256=
