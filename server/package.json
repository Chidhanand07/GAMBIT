{
  "name": "gambit-server",
  "version": "1.0.0",
  "type": "commonjs",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:arch": "depcruise src server.js services lib supabase.js --config .dependency-cruiser.cjs",
    "lint:baseline": "node ../scripts/lint-baseline/ratchet.js server",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "axios": "^1.6.2",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.3.0",
    "glicko2": "^0.8.4",
    "ioredis": "^5.10.1",
    "nanoid": "^3.3.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "jest": "^30.3.0",
    "prettier": "^3.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.2.2"
  }
}
