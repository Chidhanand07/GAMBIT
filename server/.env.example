# Server port (Railway sets this automatically)
PORT=3001

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Secret key (sb_secret_...), from Supabase Dashboard > Settings > API Keys. Bypasses RLS.
# Legacy names still read as fallbacks: SUPABASE_SERVICE_KEY, then SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Redis (Upstash or Railway Redis add-on)
REDIS_URL=redis://default:password@host:port
# Socket.IO adapter: redis (default; rooms span every replica) or none (one local instance)
SOCKET_ADAPTER=redis

# Frontend URL for CORS (set to your Vercel URL in production)
# Browser origins allowed to call this server and open a game socket (comma-separated, exact,
# no wildcards). Required in production. Example: https://gambit.app,https://www.gambit.app
CORS_ORIGINS=http://localhost:3000
# Optional: a pattern for THIS project's Vercel preview deployments only. Must start with
# ^https://, end with \.vercel\.app$ and not match other people's *.vercel.app hosts
# (checked at startup). Example: ^https://gambit-[a-z0-9-]+-yourteam\.vercel\.app$
CORS_PREVIEW_ORIGIN_REGEX=
# Deprecated: used only when CORS_ORIGINS is not set (one origin).
FRONTEND_URL=http://localhost:3000

# Chess engine URL (set to your Render URL in production).
# Canonical name. The old name ENGINE_URL is still read as a deprecated fallback (logs a warning).
GAMBIT_ENGINE_URL=http://127.0.0.1:8001

# Shared secret sent to the engine as X-Engine-Key (must equal the engine's
# ENGINE_SHARED_SECRET). Without it the server does not call the engine at all:
# analysis and post-game review are disabled. Generate: openssl rand -hex 32
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Optional: pino log level (fatal, error, warn, info, debug, trace, silent). Default: info.
LOG_LEVEL=info
