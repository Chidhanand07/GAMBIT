# Game server (server/.env, loaded with dotenv). Reference: DEPLOY.md section 4b.

# Supabase project URL and secret key (sb_secret_..., Settings > API Keys). Required.
# The key bypasses RLS. Legacy names still read, in order: SUPABASE_SERVICE_KEY, SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Shared secret sent to the engine as X-Engine-Key (same value as the engine's).
# Without it the server does not call the engine: no analysis, no post-game review.
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Chess engine URL. Default http://localhost:8001. Deprecated fallback name: ENGINE_URL.
GAMBIT_ENGINE_URL=http://localhost:8001

# Redis (Lua + Streams). Default redis://127.0.0.1:6379. Upstash uses rediss:// (TLS).
REDIS_URL=redis://127.0.0.1:6379

# HTTP port. Default 3001; Railway sets it.
# PORT=3001

# Browser origins allowed for HTTP CORS and the socket handshake: comma-separated, exact, no
# wildcards, no trailing slash. REQUIRED in production. Outside production http://localhost:3000
# and http://127.0.0.1:3000 are always allowed, so it can stay unset locally.
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# Optional: THIS project's Vercel preview deployments only. Must start with ^https://, end with
# \.vercel\.app$ and not match other people's *.vercel.app hosts.
# CORS_PREVIEW_ORIGIN_REGEX=^https://gambit-[a-z0-9-]+-yourteam\.vercel\.app$

# Deprecated: one origin, used only when CORS_ORIGINS is not set.
# FRONTEND_URL=http://localhost:3000

# Optional: Socket.IO adapter. redis (default; rooms span every replica) or none (one local instance).
# SOCKET_ADAPTER=redis

# Optional: pino log level (fatal, error, warn, info, debug, trace, silent). Default info.
# LOG_LEVEL=info

# Optional (SEC-12): https webhook that receives one JSON POST per fatal error, HTTP 500, socket
# internal_error, failed token verification, rating failure and stuck game result (Slack/Discord
# compatible). At most 20 a minute. A secret. Unset: errors are only logged.
# ERROR_WEBHOOK_URL=https://hooks.example.com/your-webhook

# Set by the platform, not by you: NODE_ENV (production in the Dockerfile),
# RAILWAY_GIT_COMMIT_SHA (release tag in error reports).
