{
  "name": "gambit-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint:baseline": "node ../scripts/lint-baseline/ratchet.js frontend",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"features/**/*.{ts,tsx}\" \"types/**/*.ts\" \"lib/chess/**/*.ts\" \"lib/server/**/*.ts\" \"lib/api/**/*.ts\" \"lib/socket/**/*.ts\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "chess.js": "^1.0.0-beta.6",
    "clsx": "^2.0.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next": "16.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.10.3",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8",
    "prettier": "^3.10.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2"
  }
}
