# Web app (frontend/.env.local, loaded by Next.js). Reference: DEPLOY.md section 5b.
# NEXT_PUBLIC_* values are compiled into the browser bundle; everything else stays server-side.

# Supabase project URL and publishable key (sb_publishable_..., Settings > API Keys). Required.
# Legacy name still read as a fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase secret key (sb_secret_...): server-side only, bypasses RLS. Required.
# NEVER prefix with NEXT_PUBLIC_ (the app refuses a secret key found in a public variable).
# Legacy names still read, in order: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SERVICE_KEY.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Game server URL (socket, /api/analysis/engine, username check, invites). Default http://127.0.0.1:3001.
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3001

# Chess engine, server-side only (the /api/maverick-move route). Default http://localhost:8001.
# Fallback name: ENGINE_URL.
GAMBIT_ENGINE_URL=http://localhost:8001
# Shared secret sent to the engine as X-Engine-Key (same value in all three services).
# Unset: "play the computer" answers 503. NEVER prefix with NEXT_PUBLIC_.
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Rate limits (server-side only): Upstash Redis REST URL and read-write token, from the Upstash
# console > your database > REST API. Required in production; NEVER prefix with NEXT_PUBLIC_.
# Unset: rate limits are OFF (one warning in the log), which is fine for local development.
# UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
