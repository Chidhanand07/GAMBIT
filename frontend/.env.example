# Supabase (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role (server-side only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Chess engine (server-side only: used by the /api/maverick-move route handler).
# Canonical name GAMBIT_ENGINE_URL; the old ENGINE_URL is still read as a fallback.
GAMBIT_ENGINE_URL=http://127.0.0.1:8001
# Shared secret sent to the engine as X-Engine-Key. NEVER prefix with NEXT_PUBLIC_.
# Must equal the engine's ENGINE_SHARED_SECRET. Generate: openssl rand -hex 32
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Backend WebSocket server URL (set to your Railway/Render URL in production)
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3001
