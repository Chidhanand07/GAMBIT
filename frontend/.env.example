# Supabase (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_...), from Supabase Dashboard > Settings > API Keys.
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback (legacy keys are
# deprecated at the end of 2026).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase secret key (sb_secret_...): server-side only, bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_. The app refuses a secret key found in a public variable.
# The legacy SUPABASE_SERVICE_ROLE_KEY is still read as a fallback.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Chess engine (server-side only: used by the /api/maverick-move route handler).
# Canonical name GAMBIT_ENGINE_URL; the old ENGINE_URL is still read as a fallback.
GAMBIT_ENGINE_URL=http://127.0.0.1:8001
# Shared secret sent to the engine as X-Engine-Key. NEVER prefix with NEXT_PUBLIC_.
# Must equal the engine's ENGINE_SHARED_SECRET. Generate: openssl rand -hex 32
ENGINE_SHARED_SECRET=change_me_same_value_in_all_three_services

# Backend WebSocket server URL (set to your Railway/Render URL in production)
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3001

# Rate limits (server-side only: lib/server/rateLimit.ts). Upstash Redis REST endpoint and
# token, from the Upstash console > your database > REST API (use the read-write token, NOT
# the read-only one). NEVER prefix with NEXT_PUBLIC_. Both unset -> rate limits are OFF (the
# app logs one warning and lets every request through); set both in production.
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
