# ==========================================
# GAMBIT - UNIFIED ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# FRONTEND (Next.js 14) 
# -> Rename to .env.local in frontend/
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
# Publishable key (sb_publishable_...). Safe for the browser.
# Legacy name still read as a fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
# Secret key (sb_secret_...). Server-side only: NEVER give it a NEXT_PUBLIC_ prefix.
# Legacy name still read as a fallback: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001" # In production, set to your Railway app URL
# Server-side only (no NEXT_PUBLIC_ prefix): the engine URL and the shared secret the
# /api/maverick-move route sends to the engine as X-Engine-Key.
GAMBIT_ENGINE_URL="http://127.0.0.1:8001"
ENGINE_SHARED_SECRET="CHANGE_ME_SAME_VALUE_IN_ALL_THREE_SERVICES" # openssl rand -hex 32

# ------------------------------------------
# BACKEND SERVER (Node.js/Express)
# -> Rename to .env in server/
# ------------------------------------------
PORT=3001
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
# Secret key (sb_secret_...). Legacy names still read: SUPABASE_SERVICE_KEY, SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"
GAMBIT_ENGINE_URL="http://127.0.0.1:8001" # In production, set to your Render engine URL
FRONTEND_URL="http://localhost:3000" # Configure for CORS
# Shared secret sent to the engine as X-Engine-Key. Must equal the engine's value.
ENGINE_SHARED_SECRET="CHANGE_ME_SAME_VALUE_IN_ALL_THREE_SERVICES"

# ------------------------------------------
# GAMBIT ENGINE (Python FastAPI)
# -> Rename to .env in chess-engine/
# ------------------------------------------
PORT=8001
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
# Secret key (sb_secret_...). Legacy name still read: SUPABASE_SERVICE_KEY
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"
# Required. Every endpoint except GET /health answers 503 until this is set, and 401 to
# callers that do not send the same value in X-Engine-Key.
ENGINE_SHARED_SECRET="CHANGE_ME_SAME_VALUE_IN_ALL_THREE_SERVICES"
# Note: Since we use the pip package 'stockfish', STOCKFISH_PATH might be optional or auto-resolved, 
# but you can explicitly define it here if needed:
# STOCKFISH_PATH="/usr/local/bin/stockfish" 
